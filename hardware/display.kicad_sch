		(property "Datasheet" "https://jlcpcb.com/api/file/downloadByFileSystemAccessId/8586177158310481920"
			(at 0 0 0)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)
		(property "Description" "Diodes Incorporated AP3031KTR-G1, SOT-23-6, boost LED driver -- in-stock substitute for AP3036BKTR-G1 (LCSC C526368, confirmed 0 stock twice, see pilink-av8). Pin1=SW (connect external inductor + external Schottky -- unlike AP3036B, AP3031 has NO internal Schottky/VOUT pin), pin2=GND, pin3=FB (reference 200mV, same as AP3036B, so R501 5.1R is unchanged: ILED=200mV/5.1R~=39.2mA), pin4=CTRL (same enable/PWM-dimming behavior as AP3036B's CTRL), pin5=OV (Over-voltage Protection Input -- 'connect to the output directly'; this pin and its VOUT wire don't exist in the AP3036B circuit), pin6=VIN -- per the real AP3031 Pin Description table, independently re-extracted in this bead (pilink-av8) via a local zlib-inflate+regex PDF text extractor (no poppler/pypdf available in this sandbox) run on the LCSC-hosted datasheet PDF for C82636. That PDF carries a 'Rev 1.6, Dec 2012, BCD Semiconductor Manufacturing Limited' letterhead, not the 'DS41442' Diodes-branded doc number -- BCD Semiconductor's LED-driver line was acquired by Diodes Incorporated, which now sells this exact silicon as AP3031KTR-G1 (LCSC/JLCPCB list it under the Diodes brand; the datasheet content -- pin table, electricals, application circuits -- matches regardless of letterhead). The datasheet's own 'Typical Application' circuit (Figure 24, 3*13 WLEDs for an LCD backlight) specifies L=4.7uH, C_IN=10uF, C_OUT=0.47uF at 1MHz switching -- used here instead of AP3036B's 22uH/1uF values (C_IN=10uF already matched, kept). External Schottky D501 (absent from the AP3036B circuit) added from SW to VOUT per the datasheet's pin1 note. LCSC C82636 -- confirmed live via jlcpcb-search MCP 2026-11-15: 11,130 units in stock, Boost topology, VIN 2.7V-16V, 1MHz switching, built-in OVP/soft-start/current-limit/OTSD."
			(at 0 0 0)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)
		(property "ki_keywords" "boost LED driver backlight"
			(at 0 0 0)
			(effects
				(font
					(size 1.27 1.27)
				)
				(hide yes)
			)
		)

(footprint "L_Abracon_AOTA-B201610"
	(version 20240108)
	(generator "pico-link-hw")
	(layer "F.Cu")
	(descr "Abracon AOTA-B201610S3R3-101-T (LCSC C42411119), 3.3uH mini molded power inductor with a polarity dot, the part RP2350 datasheet 6.3.8.2 recommends for the VREG. Body 2.00 x 1.60 x 1.00 max mm (Abracon datasheet Rev A 2024-09-13 p.4 Mechanical Specifications; RP2350 DS Figure 29). Land pattern from the same page's 'Recommended Land Pattern': two 1.00 x 1.60 mm pads with a 1.00 mm gap (centres +/-1.00 mm). Pad 2 (+X) is the polarity-dot end ('Marking (White Ink polarity dot)'); the EasyEDA/JLCPCB library footprint for C42411119 has the same pad numbering, pad size and dot side at 0 degrees, so the CPL rotation is the KiCad rotation. On this board pad 2 = +1V1, pad 1 = VREG_LX: Raspberry Pi's own reference layouts (RP2350B minimal RP-006442-DD-2, L_pol_2016; RP2350A minimal R4-S1) put the polarity dot on the +1V1 pad (pilink-7sb).")
	(tags "inductor molded 2016 polarity RP2350 VREG")
	(attr smd)
	(property "Reference" "REF**" (at 0 -2.0 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
	(property "Value" "L_Abracon_AOTA-B201610" (at 0 2.0 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
	(fp_rect (start -1.0 -0.8) (end 1.0 0.8) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
	(fp_circle (center 0.55 -0.4) (end 0.72 -0.4) (stroke (width 0.05) (type solid)) (fill solid) (layer "F.Fab"))
	(fp_line (start -0.3 -0.95) (end 0.3 -0.95) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_line (start -0.3 0.95) (end 0.3 0.95) (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
	(fp_circle (center 0.9 -1.12) (end 1.04 -1.12) (stroke (width 0.05) (type solid)) (fill solid) (layer "F.SilkS"))
	(fp_rect (start -1.75 -1.35) (end 1.75 1.05) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(fp_text user "${REFERENCE}" (at 0 0 0) (layer "F.Fab") (effects (font (size 0.4 0.4) (thickness 0.06))))
	(pad "1" smd rect (at -1.0 0) (size 1.0 1.6) (layers "F.Cu" "F.Paste" "F.Mask"))

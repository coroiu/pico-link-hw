(version 1)

# pilink-ge9: Alps SKRTLAE010 (SW101/SW102). The part's own land pattern --
# identical in KiCad's stock footprint and in JLCPCB/EasyEDA's C110293
# footprint -- puts pad 1 and the MP tabs 0.0993/0.15mm from its own 0.9mm
# NPTH locating pegs. That is the manufacturer's geometry, so the global
# 0.2mm hole_clearance is relaxed for these two footprints only (floor kept
# above zero so a real mis-placement still flags). Every other part keeps 0.2mm.
(rule skrtlae010_own_npth
	(constraint hole_clearance (min 0.09mm))
	(condition "A.Type=='Pad' && B.Type=='Pad' && ((A.memberOfFootprint('SW101') && B.memberOfFootprint('SW101')) || (A.memberOfFootprint('SW102') && B.memberOfFootprint('SW102')))"))

# pilink-rqd: backlight boost (U501/D501). The switching node Net-(D501-A)
# must stay >=1.2mm from the feedback net Net-(J501-LED_K), so the switching
# edges do not couple into the analog feedback sense.
(rule backlight_sw_vs_fb
	(constraint clearance (min 1.2mm))
	(condition "(A.NetName=='Net-(D501-A)' && B.NetName=='Net-(J501-LED_K)') || (A.NetName=='Net-(J501-LED_K)' && B.NetName=='Net-(D501-A)')"))

# pilink-912: JLCPCB 2-layer PTH annular ring minimum is 0.18mm (0.25mm
# recommended; jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-17).
# The board-wide minimum (place.py m_ViasMinAnnularWidth = 0.1) stays for
# vias, which JLCPCB rates separately; this rule holds through-hole PADS to
# 0.18mm, so a part like J401's original 0.9/0.7mm pads (0.1mm ring) fails
# DRC. U101's EP thermal vias are footprint pads but vias in function
# (0.6/0.25mm, the same class as the board's 0.6/0.3 vias), so they are exempt.
# pilink-912: J401's 0.95mm signal pads (0.55mm drill, 0.20mm ring) at the
# connector's fixed 1.10mm in-row pitch leave a 0.15mm pad-to-pad gap.
# JLCPCB lists 0.15mm as the minimum pad-to-pad clearance (SMD pads,
# different nets) and 0.10mm pad-to-track, so the floor here is 0.15mm
# between J401's own pads, written out explicitly so the gap is deliberate,
# not an accident of the netclass default.
(rule j401_pad_gap
	(constraint clearance (min 0.15mm))
	(condition "A.memberOfFootprint('J401') && B.memberOfFootprint('J401')"))

(rule pth_pad_annular_ring
	(constraint annular_width (min 0.18mm))
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && !A.memberOfFootprint('U101')"))

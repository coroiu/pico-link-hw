{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          },
          {
            "command": "bd dolt pull >/dev/null 2>&1 || true",
            "type": "command",
            "timeout": 60
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bd dolt push >/dev/null 2>&1 || true",
            "type": "command",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Merging a pull request in this repository (e.g. `gh pr merge`) that already has an APPROVED code-reviewer verdict posted on it, or that the user has explicitly described as trivial/low-risk and told the agent to merge without review"
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          },
          {
            "command": "bd dolt pull >/dev/null 2>&1 || true",
            "type": "command",
            "timeout": 60
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "bd dolt push >/dev/null 2>&1 || true",
            "type": "command",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
